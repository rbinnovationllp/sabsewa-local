# Supabase
SUPABASE_URL=https://xodmazgfibftorrlbotk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Keep test mode until live keys, webhook signature verification, idempotency,
# HTTPS callback/webhook URLs and reconciliation are verified.
RAZORPAY_ENVIRONMENT=test
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
PUBLIC_API_URL=https://api.sabsewa.in
PUBLIC_APP_URL=https://www.sabsewa.in
RAZORPAY_LIVE_RECONCILIATION_TESTED=false

# API security hardening
CORS_ORIGIN=https://www.sabsewa.in,https://sabsewa.in
API_RATE_LIMIT_PER_MINUTE=120
