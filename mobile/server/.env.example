PORT=5001

SUPABASE_URL=replace_with_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Google Gemini / Google Cloud. Required for XPRIZE AI-native workflows.
# Use either Google AI Studio API key mode or Vertex AI credentials, depending on deployment.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TRANSLATION_MODEL=replace_with_approved_current_flash_or_flash_lite_model
GEMINI_TRANSLATION_VERSION=2026-07-30
GEMINI_TRANSLATION_MAX_INPUT_CHARS=1200
GEMINI_TRANSLATION_MAX_OUTPUT_TOKENS=512
GEMINI_TRANSLATION_ESTIMATED_INR_PER_TOKEN=0.00003
GOOGLE_CLOUD_PROJECT=replace_with_google_cloud_project_id_if_using_vertex_ai
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_PROVIDER=google_ai_studio

# Razorpay is the primary payment gateway for SabSewa Local Security Wallet deposits/top-ups.
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
# Use `test` until Razorpay Live keys, live webhook secret, HTTPS callbacks,
# idempotency, atomic wallet crediting and reconciliation are verified.
RAZORPAY_ENVIRONMENT=test
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
PUBLIC_API_URL=https://api.sabsewa.in
RAZORPAY_LIVE_RECONCILIATION_TESTED=false

# Supabase Database Webhooks / Auth Hooks / Edge callbacks can call:
# https://api.sabsewa.in/api/webhooks/supabase
# Send this value as Authorization: Bearer <secret> or x-supabase-webhook-secret.
SUPABASE_WEBHOOK_SECRET=replace_with_long_random_supabase_webhook_secret

# AWS S3 is used for SabSewa Local product images and documents.
# S3 is storage only. It does not replace Gemini / Google Cloud AI usage.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=replace_with_s3_bucket_name
AWS_S3_PUBLIC_BASE_URL=https://replace_with_public_asset_domain_or_bucket_url
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key

PUBLIC_APP_URL=https://sabsewa.app

# API security hardening
# Comma-separated allowed origins. Example: https://www.sabsewa.in,https://sabsewa.in
CORS_ORIGIN=https://www.sabsewa.in,https://sabsewa.in
API_RATE_LIMIT_PER_MINUTE=180

# Firebase Cloud Messaging for low-cost customer/vendor notifications.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON in production secret storage, or set the split fields below.
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_CLIENT_EMAIL=replace_with_firebase_client_email
FIREBASE_PRIVATE_KEY=replace_with_firebase_private_key_with_escaped_newlines
FIREBASE_SERVICE_ACCOUNT_JSON=replace_with_firebase_service_account_json_secret

# Browser PWA push notifications. The public key is also exposed to the web app as
# EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY. Keep the private key only on the backend.
WEB_PUSH_VAPID_PUBLIC_KEY=replace_with_web_push_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=replace_with_web_push_vapid_private_key
WEB_PUSH_CONTACT_EMAIL=support@sabsewa.in
