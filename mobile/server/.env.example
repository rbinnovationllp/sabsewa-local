PORT=5001

SUPABASE_URL=replace_with_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Google Gemini / Google Cloud. Required for XPRIZE AI-native workflows.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Razorpay is the primary payment gateway for SabSewa Local Security Wallet deposits/top-ups.
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# AWS S3 is used for SabSewa Local product images and documents.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=replace_with_s3_bucket_name
AWS_S3_PUBLIC_BASE_URL=https://replace_with_public_asset_domain_or_bucket_url
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key

PUBLIC_APP_URL=https://sabsewa.app
