{
    "name": "sabsewa-server",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.730.0",
        "@aws-sdk/s3-request-presigner": "^3.730.0",
        "@google/genai": "^0.14.0",
        "@google/generative-ai": "^0.24.1",
        "@supabase/supabase-js": "^2.112.2",
        "axios": "^1.6.7",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.18.2",
        "multer": "^2.2.0",
        "razorpay": "^2.9.8",
        "sharp": "^0.35.3",
        "web-push": "^3.6.7",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "nodemon": "^3.0.2"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "validate:onboarding": "node scripts/validate-onboarding-production.mjs",
        "validate:billing": "node scripts/validate-platform-billing.mjs",
        "validate:retention-pricing-conversation": "node scripts/validate-retention-pricing-conversation.mjs",
        "pm2:start": "pm2 start ecosystem.config.cjs --env production",
        "pm2:reload": "pm2 reload sabsewa-local-api --update-env",
        "pm2:stop": "pm2 stop sabsewa-local-api",
        "pm2:logs": "pm2 logs sabsewa-local-api"
    }
}
