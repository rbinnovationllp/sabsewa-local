{
    "extends":  "expo/tsconfig.base",
    {
  "compilerOptions": {
    "strict": true,
    // Fix: Deprecation warning. Silences the warning while baseUrl remains active.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    // Fix: Syntax errors. Added proper quotes around key/value.
    "paths": {
      "@/*": ["./*"]
    }
  },
    "include":  [
                    "**/*.ts",
                    "**/*.tsx",   
                    "app/_layout.tsx",
                    "app/index.tsx",
                    "app/hlm/**/*.tsx",
                    "app/hyperlocal/**/*.tsx",
                    "app/vendor/**/*.tsx",
                    "app/rider/**/*.tsx",
                    "app/customer/dashboard.tsx",
                    "app/customer/discover.tsx",
                    "app/customer/GeminiOrder.tsx",
                    "app/customer/track.tsx",
                    "app/company/**/*.tsx",
                    "app/auth/**/*.tsx",
                    "components/**/*.ts",
                    "components/**/*.tsx",
                    "constants/**/*.ts",
                    "contexts/**/*.ts",
                    "contexts/**/*.tsx",
                    "core/features/marketplace/screens/hyperlocal/**/*.ts",
                    "core/features/marketplace/screens/hyperlocal/**/*.tsx",
                    ".expo/types/**/*.ts",
                    "expo-env.d.ts"
                    "hooks/**/*.ts",
                    "lib/**/*.ts",
                    "providers/**/*.ts",
                    "providers/**/*.tsx",
                    "services/**/*.ts",
                    "types/**/*.ts",
                    "utils/**/*.ts",
                    "src/services/**/*.ts",
                    "src/utils/**/*.ts",
                    "expo-env.d.ts",
                    ".expo/types/**/*.ts",
                    "app/customer-registration.tsx",
                    "app/vendor-registration.tsx"
                ],
    "exclude":  [
                    "_archived_non_local_20260725",
                    "server/node_modules",
                    "node_modules"
                ]
}
