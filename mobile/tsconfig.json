{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app/_layout.tsx",
    "app/index.tsx",
    "app/hlm/**/*.tsx",
    "app/hyperlocal/**/*.tsx",
    "app/vendor/**/*.tsx",
    "app/rider/**/*.tsx",
    "app/customer/dashboard.tsx",
    "app/customer/discover.tsx",
    "app/customer/GeminiOrder.tsx",
    "app/customer/track.tsx",
    "app/company/**/*.tsx",
    "app/auth/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "contexts/**/*.ts",
    "contexts/**/*.tsx",
    "core/features/marketplace/screens/hyperlocal/**/*.ts",
    "core/features/marketplace/screens/hyperlocal/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "providers/**/*.ts",
    "providers/**/*.tsx",
    "services/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "src/services/**/*.ts",
    "src/utils/**/*.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "_archived_non_local_20260725",
    "server/node_modules",
    "node_modules"
  ]
}
